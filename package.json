{
  "name": "lcinocare",
  "productName": "LcinoCare",
  "version": "1.15.1",
  "description": "Therapy for Your Mac \u2014 storage health, junk cleaning, and system care for macOS.",
  "main": "src/main/main.js",
  "author": "LCINO",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "scan": "node src/main/scanner.js --cli",
    "dist": "electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.lcino.care",
    "productName": "LcinoCare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/mock.html",
      "!src/renderer/mock-bridge.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "type": "distribution",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "publish": {
      "provider": "github",
      "owner": "LCINO",
      "repo": "lcinocare"
    },
    "afterSign": "build/afterSign.js",
    "dmg": {
      "title": "LcinoCare ${version}",
      "background": "build/dmg-background.png",
      "window": {
        "x": 240,
        "y": 180,
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 165,
          "y": 250,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 495,
          "y": 250,
          "type": "file",
          "path": "dist/mac-arm64/LcinoCare.app"
        }
      ],
      "writeUpdateInfo": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}